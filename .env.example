# sff (Standalone File Fetcher) configuration
# Copy this to .env and fill in the SECRET values from your Spotify Developer App.
# .env is gitignored — never commit it.

# ─── SECRETS (required) ──────────────────────────────────────────────────────
# Get these from https://developer.spotify.com/dashboard
# Create an app, copy Client ID and Secret, and add the redirect URI to the app's settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ─── USER PATHS (required, machine-specific) ─────────────────────────────────
# Where downloaded MP3s are stored. sff creates one subfolder per playlist:
#   D:/Music Backup/Incoming/Opening/...
#   D:/Music Backup/Incoming/Progressive/...
MUSIC_FOLDER=D:/Music Backup/Incoming

# Rekordbox library DB. On Windows it's typically:
#   C:/Users/<YOU>/AppData/Roaming/Pioneer/rekordbox/master.db
REKORDBOX_DB_PATH=C:/Users/Lenovo/AppData/Roaming/Pioneer/rekordbox/master.db

# Traktor collection. On Windows it's typically:
#   C:/Users/<YOU>/Documents/Native Instruments/Traktor X.X.X/collection.nml
TRAKTOR_NML_PATH=C:/Users/Lenovo/Documents/Native Instruments/Traktor 3.8.0/collection.nml

# Rekordbox analysis (ANLZ) root. Always inside the Rekordbox app dir on Windows:
#   C:/Users/<YOU>/AppData/Roaming/Pioneer/rekordbox/share/PIONEER/USBANLZ
ANLZ_ROOT=C:/Users/Lenovo/AppData/Roaming/Pioneer/rekordbox/share/PIONEER/USBANLZ

# ─── BEHAVIOR (optional — defaults shown) ────────────────────────────────────
# Spotify playlists with this prefix get synced. "FF Opening" → playlist named "Opening" in RB/Traktor.
PLAYLIST_PREFIX=FF
